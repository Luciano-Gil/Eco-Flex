// ===============================================================
// configuracion de base de datots y generacion de cliente prisma
// ===============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // variable de entorno definida en .env, conectada a la base de datos PostgreSQL
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"] // para compatibilidad con Vercely otros entornos de despliegue, para que funcione en cualquier sistema operativo y arquitectura
}

// ============================================================================
// ENUMERACIONES (VALORES ESTÁNDAR DEL SISTEMA)
// ============================================================================

// Roles de acceso al sistema para autenticación y protección de rutas (es decir que un usuario puede ser CLIENTE, CHOFER o ADMINISTRADOR)
enum Role {
  CLIENT    // Usuario 
  DRIVER    // Chofer 
  ADMIN     // Administrador 
}

// Modalidad de cobro del flete:
// PARCEL: Cobro por volumen (m3) para cargas parciales o pocos bultos
// REMOVAL: Cobro por distancia (km) para media mudanza o camión completo
enum ServiceType {
  PARCEL
  REMOVAL
}

// Estados del ciclo de vida de la carga
enum CargoStatus {
  PENDING       // Publicado por el cliente, en espera de chofer
  ACCEPTED      // Aceptado y asignado a un camión
  IN_TRANSIT    // En viaje por la ruta
  DELIVERED     // Entregado en destino
  DISCREPANCY   // El chofer reportó diferencias entre lo declarado y lo real
  CANCELLED     // Pedido cancelado
}

// Categorías estandarizadas de tamaño para cajas y muebles
// Utilizado por el inventario dinámico (procesado por Whisper/Gemini)
enum ItemSize {
  BOX_SMALL      // ~0.04 m3 (Libros, vajilla compacta, objetos densos)
  BOX_MEDIUM     // ~0.12 m3 (Caja estándar de mudanza, ropa, adornos)
  BOX_LARGE      // ~0.25 m3 (Acolchados, juguetes, cosas livianas pero voluminosas)
  FURNITURE_M    // ~0.80 m3 (Mesa chica, sillas, electrodoméstico pequeño)
  FURNITURE_L    // ~1.80 m3 (Heladera alta, sillón de 3 cuerpos, somier)
}

// Categorías estandarizadas de peso aproximado
enum ItemWeight {
  LIGHT          // Menos de 10 kg (se levanta con una mano sin esfuerzo)
  MEDIUM         // 10 a 25 kg (lo levanta un adulto promedio)
  HEAVY          // 25 a 50 kg (requiere dos personas para moverlo)
  VERY_HEAVY     // Más de 50 kg (requiere carro de carga o herramientas)
}

// Estados de auditoría documental del transportista
enum DocStatus {
  PENDING        // Documentación enviada, pendiente de revisión del admin
  APPROVED       // Aprobada: el chofer está habilitado para tomar viajes
  REJECTED       // Rechazada con motivo especificado
}

// Estados de la transacción financiera en custodia (Escrow)
enum PaymentStatus {
  PENDING        // Esperando que el cliente abone en Mercado Pago
  HELD_ESCROW    // Dinero cobrado y retenido por EcoFlex hasta entrega exitosa
  RELEASED       // Fondos liberados y transferidos al chofer
  REFUNDED       // Reembolsado al cliente ante cancelación
}

// ============================================================================
// ENTIDAD: USUARIOS (CLIENTES, CHOFERES Y ADMINISTRADORES)
// ============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  
  // Relación 1:N: Cargas creadas por este usuario como cliente
  clientCargos Cargo[]       @relation("ClientCargos")

  // Relación 1:N: Cargas asignadas a este usuario como chofer
  driverCargos Cargo[]       @relation("DriverCargos")

  // Relación 1:1: Legajo documental del chofer (solo si role == DRIVER)
  driverDoc    DriverDoc?

  // Relación 1:N: Rutas o trayectos declarados por el chofer
  driverRoutes DriverRoute[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================================================
// ENTIDAD: CARGAS Y MUDANZAS 
// ============================================================================

model Cargo {
  id             String       @id @default(uuid())
  serviceType    ServiceType  @default(PARCEL)
  status         CargoStatus  @default(PENDING)
  
  // Datos del recorrido 
  originAddress  String
  destAddress    String
  distanceKm     Float?
  
  // Cálculos automáticos con margen de seguridad para el transportista
  totalVolumeM3  Float?       // Volumen total estimado en metros cúbicos
  totalWeightKg  Float?       // Peso total estimado en kilogramos
  finalPrice     Float?       // Tarifa calculada según m3 o km
  
  // Transcripción de voz (Whisper) y notas de ítems difíciles de encasillar
  voiceRawText   String?      // Texto crudo generado por la transcripción
  extraNotes     String?      // Ej: "1 mesa plegable y 2 banquitos chicos"
  
  // Relación: Cliente que solicitó la carga (Obligatorio)
  userId         String
  user           User         @relation("ClientCargos", fields: [userId], references: [id], onDelete: Cascade)

  // Relación: Chofer asignado al flete (Opcional, null mientras esté PENDING)
  driverId       String?
  driver         User?        @relation("DriverCargos", fields: [driverId], references: [id], onDelete: SetNull)
  
  // Relaciones hijas: Inventario de bultos, fotos y registro de pago
  items          CargoItem[]
  images         CargoImage[]
  payment        Payment?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("cargos")
}

// ============================================================================
// ENTIDAD: ÍTEMS DE LA CARGA (INVENTARIO DINÁMICO)
// ============================================================================

model CargoItem {
  id          String      @id @default(uuid())
  name        String      // Ej: "Cajas de ropa", "Lavarropas"
  quantity    Int         @default(1)
  size        ItemSize    @default(BOX_MEDIUM)
  weight      ItemWeight  @default(LIGHT)
  isConfirmed Boolean     @default(false) // Tilde de confirmación del cliente
  
  // Relación: Cada ítem pertenece a un pedido de carga puntual
  cargoId     String
  cargo       Cargo       @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("cargo_items")
}

// ============================================================================
// ENTIDAD: FOTOS DE RESPALDO (EVIDENCIA VISUAL OPCIONAL)
// ============================================================================

model CargoImage {
  id        String   @id @default(uuid())
  imageUrl  String   // URL de almacenamiento de la foto
  
  // Relación: La imagen pertenece a una carga puntual
  cargoId   String
  cargo     Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@map("cargo_images")
}

// ============================================================================
// ENTIDAD: DOCUMENTACIÓN DEL TRANSPORTISTA (CONTROL DOCUMENTAL)
// ============================================================================

model DriverDoc {
  id             String     @id @default(uuid())
  cuit           String     @unique
  licenseUrl     String     // URL del comprobante de licencia de conducir
  vtvUrl         String     // URL del certificado VTV / RTO
  insuranceUrl   String     // URL de la póliza de seguro del vehículo/carga
  status         DocStatus  @default(PENDING)
  rejectionNote  String?    // Motivo si el administrador rechaza la documentación

  // Relación 1:1 con User (Chofer)
  driverId       String     @unique
  driver         User       @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("driver_docs")
}

// ============================================================================
// ENTIDAD: RUTAS DECLARADAS DEL TRANSPORTISTA (TRAYECTOS VACÍOS)
// ============================================================================

model DriverRoute {
  id             String     @id @default(uuid())
  originCity     String
  destCity       String
  departureDate  DateTime
  availableM3    Float      // Capacidad volumétrica libre
  availableKg    Float      // Capacidad de peso libre
  isActive       Boolean    @default(true)

  // Relación 1:N con User (Chofer)
  driverId       String
  driver         User       @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("driver_routes")
}

// ============================================================================
// ENTIDAD: REGISTRO FINANCIERO Y CUSTODIA (ESCROW)
// ============================================================================

model Payment {
  id             String         @id @default(uuid())
  amount         Float          // Monto total pagado por el cliente
  platformFee    Float          // Comisión EcoFlex (10%)
  insuranceFee   Float          @default(0) // Costo seguro opcional (1%)
  driverAmount   Float          // Monto a liquidar al transportista
  status         PaymentStatus  @default(PENDING)
  mpPreferenceId String?        // ID de la preferencia en Mercado Pago
  mpPaymentId    String?        // ID de pago devuelto por el Webhook de MP

  // Relación 1:1 con Cargo
  cargoId        String         @unique
  cargo          Cargo          @relation(fields: [cargoId], references: [id], onDelete: Restrict)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("payments")
}